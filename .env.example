# Copy to .env and fill in before running `npm run dev`.
# In production these are set on Vercel → Settings → Environment Variables.
# They are read only by api/chat.js (server side) — never bundled into the
# client, which is the whole point of the function.

# Required: secret key for the AI provider.
CHAT_API_KEY=

# Optional: any OpenAI-compatible chat-completions endpoint + model.
# Defaults below are Groq's free tier.
# CHAT_API_URL=https://api.groq.com/openai/v1/chat/completions
# CHAT_MODEL=openai/gpt-oss-120b
